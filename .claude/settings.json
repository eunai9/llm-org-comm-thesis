{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe -e bash /home/eunai9/projects/thesis/.claude/hooks/session_start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe -e bash /home/eunai9/projects/thesis/.claude/hooks/git_guard.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "wsl.exe -e bash /home/eunai9/projects/thesis/.claude/hooks/commit_check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
